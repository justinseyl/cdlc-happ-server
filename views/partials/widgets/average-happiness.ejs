<div class="widget average-happiness">
  <div class="widget-header">
    <div class="widget-title">Average Happiness</div>
  </div>
  <div class="widget-content">
    <div class="widget-content-inner">
      <div class="widget-content-inner-container">
        <div class="widget-emoji emoji-<%= Math.round(avgHappiness) %>"></div>
        <div class="widget-emoji-content">
          <div class="widget-emoji-content-inner">
            <h1><%= label %></h1>
            <h2><%= value %></h2>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
