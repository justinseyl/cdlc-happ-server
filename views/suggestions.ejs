<!DOCTYPE html>
<html>
<%- include('partials/meta/header') %>

<body>

  <div class="main">
    <%- include('partials/sidebar', { currentPage: 'suggestions' }) %>

    <div class="dashboard">
        <div class="header">
          <h1>Suggestions</h1>
          <div class="header-actions">
            <% if (data.userRole === 'admin' || data.userRole === 'superadmin') { %>
              <%- include('partials/form/select', { id: 'department', label: 'Department', name: 'department', options: departments, selectedValue: '' }) %>
            <% } %>
            <%- include('partials/form/icon-button', { icon: 'issues-dark.svg', alt: 'Edit', onClick: 'openPopup("issue-popup")' }) %>
            <%- include('partials/form/icon-button', { icon: 'suggestions-dark.svg', alt: 'Add', onClick: 'openPopup("suggestion-popup")' }) %>
            <%- include('partials/form/icon-button', { icon: 'notification.svg', alt: 'Delete', onClick: 'handleDelete()' }) %>
          </div>
        </div>
        <div class="content">
          <div class="content-container">
            <div class="widget new-surveys">
              <div class="widget-header">
                <div class="widget-title">All Suggestions</div>
              </div>
              <div class="widget-content">
                <div class="survey-list">
                  <% data.suggestions.forEach(issue => { %>
                    <div class="survey-card row">
                      <div class="col-md-3">
                        <div class="group">
                          <div class="frame-40">
                            <div class="text-wrapper-16">Name</div>
                            <div class="text-wrapper-17"><%= issue.title %></div>
                          </div>
                        </div>
                      </div>
                      <div class="col-md-3">
                        <div class="group">
                          <div class="frame-40">
                            <div class="text-wrapper-16">Content</div>
                            <div class="text-wrapper-17"><%= issue.content %></div>
                          </div>
                        </div>
                      </div>
                      <div class="col-md-3">
                        <div class="group">
                          <div class="frame-40">
                            <div class="text-wrapper-16">Status</div>
                            <div class="text-wrapper-17"><%= issue.status %></div>
                          </div>
                        </div>
                      </div>
                      <div class="col-md-3">
                        <div class="group">
                          <div class="frame-40">
                            <div class="text-wrapper-16">Date</div>
                            <div class="text-wrapper-17"><%= issue.created %></div>
                          </div>
                        </div>
                      </div>
                      
                    </div>
                  <% }); %>
                </div>
              </div>
            </div>
          </div>
        </div>
    </div>
  </div>

    <%- include('partials/meta/footer') %>

</body>

</html>
