<!DOCTYPE html>
<html>
<%- include('partials/meta/header') %>

<body>
  <div class="main">
    <%- include('partials/sidebar', { currentPage: 'surveys' }) %>

    <div class="dashboard">
        <div class="header">
          <h1>
            <div class="profile-widget" onclick="window.history.back()" style="cursor: pointer;">
                    <div class="profile-widget-header">
                      <div class="profile-widget-header-icon">
                        <img class="icon" src="/icons/arrow-left.svg" alt="Edit">
                      </div>
                    </div>
                  </div>
            Survey Details
          </h1>
          <div class="header-actions">
            <%- include('partials/form/icon-button', { icon: 'issues-dark.svg', alt: 'Edit', onClick: 'openPopup("issue-popup")' }) %>
            <%- include('partials/form/icon-button', { icon: 'suggestions-dark.svg', alt: 'Add', onClick: 'openPopup("suggestion-popup")' }) %>
            <%- include('partials/form/icon-button', { icon: 'notification.svg', alt: 'Delete', onClick: 'handleDelete()' }) %>
          </div>
        </div>
        <div class="content">
          <div class="content-container">
            <div class="widget survey-details">
              <div class="widget-header">
                <div class="widget-title">
                  User: <%= data_user %>
                </div>
              </div>
              <div class="widget-content">
                <div class="survey-list">
                  <% data.forEach((item, index) => { %>
                    <div class="survey-card row" id="card-<%= index %>" onClick="window.location.href = '/surveys/<%= item.id %>/<%= item.user %>'">
                      <div class="col-md-8">
                        <div class="group">
                          <div class="frame-40">
                            <div class="text-wrapper-16">Question</div>
                            <div class="text-wrapper-17"><%= item.question %></div>
                          </div>
                        </div>
                      </div>
                      <div class="col-md-4">
                        <div class="group">
                          <div class="frame-40">
                            <div class="text-wrapper-16">Answer</div>
                            <div class="text-wrapper-17"><%= item.answer %></div>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                </div>
              </div>
            </div>
          </div>
        </div>
    </div>
  </div>

  <%- include('partials/meta/footer') %>

  <script>
    function openEditSurveyPopup() {
      // Logic to open the survey edit popup
    }

    function handleDeleteSurvey() {
      if (confirm('Are you sure you want to delete this survey?')) {
        // Logic to delete the survey
      }
    }
  </script>

  <style>
    .survey-card {
      cursor: pointer;
      margin-bottom: 15px;
    }
  </style>

</body>
</html>
