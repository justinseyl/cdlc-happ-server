<!DOCTYPE html>
<html>
<%- include('partials/meta/header') %>

<body>
  <div class="main">
    <%- include('partials/sidebar', { currentPage: 'time' }) %>

    <div class="dashboard">
        <div class="header">
          <h1>Timesheet</h1>
          <div class="header-actions">
            <%- include('partials/form/icon-button', { icon: 'issues-dark.svg', alt: 'Edit', onClick: 'openPopup("issue-popup")' }) %>
            <%- include('partials/form/icon-button', { icon: 'suggestions-dark.svg', alt: 'Add', onClick: 'openPopup("suggestion-popup")' }) %>
            <%- include('partials/form/icon-button', { icon: 'notification.svg', alt: 'Delete', onClick: 'handleDelete()' }) %>
          </div>
        </div>
        <div class="content">
          <div class="content-container">
            <div class="profile-container">
              <div class="profile-content">
                  <div id="personal" class="profile-tab-content">
                    <div class="profile-widget">
                      <div class="profile-widget-header">
                        <h1>
    <% if (user.role === 'admin' || user.role === 'superadmin') { %>
      All Users for Week (<%= moment(startDate).format('MM/DD/YYYY') %> - <%= moment(endDate).format('MM/DD/YYYY') %>)
    <% } else if (user.role === 'manager') { %>
      My Team for Week (<%= moment(startDate).format('MM/DD/YYYY') %> - <%= moment(endDate).format('MM/DD/YYYY') %>)
    <% } else { %>
      My Week (<%= moment(startDate).format('MM/DD/YYYY') %> - <%= moment(endDate).format('MM/DD/YYYY') %>)
    <% } %>
  </h1>
                      </div>
                      <div class="profile-widget-content">
                        <div class="profile-widget-content-list">
                          <% const daysOfWeek = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']; %>
                          <% daysOfWeek.forEach((day, index) => { %>
                            <div class="profile-widget-content-list-item">
                              <h1><%= day %></h1>
                              <h2>
                                <% 
                                  const dayLog = timeLogs.find(log => moment(log.log_date).isoWeekday() === index + 1); 
                                  const totalHours = dayLog ? dayLog.total_hours : 0;
                                %>
                                <%= (totalHours || 0).toFixed(2) %> Hours
                              </h2>
                            </div>
                          <% }); %>
                        </div>
                      </div>
                    </div>
                  </div>
              </div>
              <div class="profile-sidebar">
                <div class="profile-sidebar-widget">
                  <div class="profile-sidebar-widget-header">
                    <div class="profile-sidebar-widget-header-text">Weekly Totals</div>
                  </div>
                  <div class="profile-sidebar-widget-content">
                    <div class="profile-sidebar-widget-content-inner">
                      <div class="profile-sidebar-widget-content-inner-list">
                        <div class="sidebar-widget-item">
                            <div class="sidebar-widget-item-inner">
                              <h1>Shifts Worked</h1>
                              <h2><%= totalShifts || 0 %></h2>
                            </div>
                        </div>
                        <div class="sidebar-widget-item">
                            <div class="sidebar-widget-item-inner">
                              <h1>Hours Worked</h1>
                              <%= (totalHours || 0).toFixed(2) %> Hours
                            </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
    </div>
  </div>

  <%- include('partials/popup-form', { id: 'issue-popup', header: 'Immediate Issue', action: '/issues/create', type: 'issue' }) %>
  <%- include('partials/popup-form', { id: 'suggestion-popup', header: 'New Suggestion', action: '/suggestions/create', type: 'suggestion' }) %>

  <%- include('partials/meta/footer') %>

</body>

</html>
