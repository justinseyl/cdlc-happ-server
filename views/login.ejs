<!DOCTYPE html>
<html>
<%- include('partials/meta/header') %>
<body class="login-body">
  <div class="login-container">
      <div class="login-card">
        <div class="login-card-logo">
          <img src="/images/logo/cdl_manager-color.png">
        </div>
        <div class="login-card-header">
          <div class="login-header-left">
            <h3>Log In</h3>
            <a href="/register">/ Sign Up</a>
          </div>
          <a href="/auth/companies" class="login-header-companies-button">Our Companies</a>
        </div>
        <div class="login-card-body">
          <form class="login-form" action="/auth/login" method="post">
            <div>
              <div class="login-input-group">
                <input id="username" name="username" type="text" class="login-form-control" placeholder="Email Address">
              </div>
              <div class="login-input-group">
                <input id="password" type="password" name="password" class="login-form-control" placeholder="Password">
              </div>
            </div>
            <div class="login-form-additional">
              <div class="login-custom-control">
                <input id="sessionId" class="login-control-input" type="checkbox" name="checkbox1" value="persist">
                <label class="login-control-label">Stay signed in</label>
              </div>
              <div class="login-forgot-pass">
                <a href="/forgot">Forgot Password?</a>
              </div>
            </div>
            <% if (error) { %>
          <div class="login-error-message"><%= error %></div>
        <% } %>
            <div class="login-submit-button">
              <input type="submit" value="Log In" class="btn login-btn">
            </div>
          </form>
        </div>
      </div>
  </div>

    <%- include('partials/meta/footer') %>
</body>
</html>
